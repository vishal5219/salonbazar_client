# Copy to .env.development (npm run dev) or .env.production (npm run build)
# Vite loads the file matching the active mode automatically.

# App & API
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# Supabase (optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay public key (live/test must match server RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=

# Cloudinary (optional uploads)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Google OAuth2 — same Client ID as GOOGLE_CLIENT_ID on server
# Authorized JavaScript origins must include your VITE_APP_URL
VITE_GOOGLE_CLIENT_ID=
